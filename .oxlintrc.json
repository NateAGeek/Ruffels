{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "jsx-a11y", "jest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2020": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".pnpm-store/**", "src-tauri/target/**"],
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default-member": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "src/test.setup.ts"
      ],
      "env": {
        "jest": true
      }
    },
    {
      "files": ["*.config.js", "*.config.cjs", "*.config.mjs", "*.config.ts"],
      "env": {
        "node": true
      }
    }
  ]
}
